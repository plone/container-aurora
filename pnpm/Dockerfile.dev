# syntax=docker/dockerfile:1
# The base is passed in as a complete reference rather than assembled from a
# version tag, so CI can pin it to the manifest digest built in the same run.
# The default keeps a bare `docker build` working.
ARG BUILDER_REF=plone/aurora-builder:latest
FROM ${BUILDER_REF}

LABEL maintainer="Plone Community <dev@plone.org>" \
      org.label-schema.name="aurora-dev" \
      org.label-schema.description="Plone Aurora development image" \
      org.label-schema.vendor="Plone Foundation"

WORKDIR /app

EXPOSE 3000 6006

ENTRYPOINT ["pnpm"]
CMD ["start"]
